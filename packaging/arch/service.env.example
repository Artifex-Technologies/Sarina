# Copy this file to /etc/sarina/service.env and edit it, then
# restart the service: systemctl restart sarina-service
#
# The unit loads this file optionally (EnvironmentFile=-...), so the
# service still starts with these defaults if you haven't created it yet:
# no auth token, loopback-only (127.0.0.1).

# Required for anything other than same-host access.
SARINA_SERVICE_TOKEN=

# Local model backend the service talks to by default (sessions can
# override these per-request).
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=local-token
OPENAI_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
